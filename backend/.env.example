# Server
PORT=8080
NODE_ENV=development

# CORS - 前端访问后端的来源；本地默认 5173；生产填 Render Static Site URL
CORS_ORIGIN=http://localhost:5173

# Finnhub - https://finnhub.io
FINNHUB_API_KEY=

# DeepSeek - https://platform.deepseek.com  (OpenAI 兼容)
# 也可替换为任何 OpenAI 兼容的 API，例如把 BASE_URL 改成 OpenAI / 通义千问 / Moonshot
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Supabase - 从 Project Settings -> API 获取
# 必须使用 service_role key（仅后端使用，绝对不要暴露给前端）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
